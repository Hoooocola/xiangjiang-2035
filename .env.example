# PostgreSQL. Store timestamps in UTC; clients format them in the user's timezone.
DATABASE_URL=postgresql://postgres@localhost:55432/xiangjiang2035_dev
TEST_DATABASE_URL=postgresql://postgres@localhost:55432/xiangjiang2035_test

# DEV ONLY authentication adapter. Production refuses this mode.
ALLOW_DEV_AUTH=false
DEV_AUTH_USER_EMAIL=student.owner@example.test

# Demo seed must be explicitly enabled and is blocked in production.
ALLOW_DEMO_SEED=false

# Reserved existing integrations; M1 does not implement them.
MAP_PROVIDER_TOKEN=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ADAPTER=local-development
LOCAL_STORAGE_ROOT=.data/uploads
