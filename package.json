{
  "name": "xiangjiang-2035",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "RUN_DB_TESTS=1 vitest run tests/m1.integration.test.ts tests/m2.integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:local:start": "bash scripts/local-db.sh start",
    "db:local:stop": "bash scripts/local-db.sh stop",
    "db:local:status": "bash scripts/local-db.sh status",
    "db:verify:fresh": "bash scripts/verify-fresh-db.sh",
    "scene:prepare": "node scripts/prepare-scene-data.mjs",
    "scene:terrain": "node scripts/prepare-terrain.mjs",
    "scene:context": "node scripts/prepare-context.mjs && node scripts/prepare-environment.mjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "leaflet": "1.9.4",
    "lucide-react": "^1.59.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "3.0.0",
    "@types/leaflet": "1.9.21",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.4",
    "osmtogeojson": "3.0.0-beta.5",
    "pbf": "5.1.2",
    "pmtiles": "4.5.0",
    "polygon-clipping": "0.15.7",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
